 Line  I  Addr  Code            Source

    1:				;Ejemplo1 Generar un tren de pulsos de 10khz sobre
    2:				;el pin P1.0 usando interrupciones del timer 0
    3:
    4:		N      0000	org 0000h         ; vector de reset
    5:	  0000	80 2E		sjmp main
    6:
    7:		N      000B	org 00Bh          ; vector interrupción del timer 0
    8:	  000B	B2 90		cpl P1.0
    9:	  000D	32		reti
   10:
   11:		N      0030	org 0030h         ; programa principal
   12:	  0030			main:
   13:	  0030	75 89 02	    mov TMOD,#2   ; Timer 0 en modo 2 (auto-reload)
   14:	  0033	75 8C CE	    mov TH0,#206  ; cargar 206 en TH0
   15:	  0036	D2 8C		    setb TR0      ; inicia el timer 0
   16:	  0038	D2 A9		    setb ET0      ; habilita interrupción del timer 0
   17:	  003A	D2 AF		    setb EA       ; habilita interrupción global
   18:	  003C	80 FE		    sjmp $        ; bucle infinito esperando la interrupción
   19:
   20:				    END               ; <<< NECESARIO para que compile





