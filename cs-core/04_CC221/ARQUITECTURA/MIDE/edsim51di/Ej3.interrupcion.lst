	Source File:	C:\Users\USER\Documents\CICLOS)__(\CICLO25-1\ARQUITECTURA\MIDE\edsim51di\Ej3.interrupcion.asm
	Object File:	C:\Users\USER\Documents\CICLOS)__(\CICLO25-1\ARQUITECTURA\MIDE\edsim51di\Ej3.interrupcion.hex
	List File:	C:\Users\USER\Documents\CICLOS)__(\CICLO25-1\ARQUITECTURA\MIDE\edsim51di\Ej3.interrupcion.lst



 Line  I  Addr  Code            Source

    1:				;Ejemplo 2(Usando más de una interrupción):
    2:				;Deseamos generar dos trenes de pulsos de diferentes frecuencias. Por ejemplo,
    3:				;un tren de pulsos de 20KHz sobre P3.4 y un tren de pulsos de 500Hz sobre P3.5.
    4:
    5:				;El programa debajo pudiera ser usado para generar estos trenes de pulsos.
    6:		N      0000	ORG 0000h           ; direccion de inicio Vector de reset
    7:	  0000	80 2E		    SJMP MAIN
    8:
    9:		N      000B	ORG 000Bh           ; Vector de interrupción Timer 0
   10:	  000B	B2 B4		    CPL P3.4        ; Invierte el estado de P3.4 (tren de 20kHz)
   11:	  000D	32		    RETI
   12:
   13:		N      001B	ORG 001Bh           ; Vector de interrupción Timer 1
   14:	  001B	02 00 4B	    LJMP TIMER1ISR  ; Salta a la rutina del Timer 1
   15:
   16:		N      0030	ORG 0030h           ; Programa principal
   17:	  0030			MAIN:
   18:	  0030	75 89 12	    MOV TMOD, #12h  ; Timer 0 en modo 2 (auto-reload), Timer 1 en modo 1 (16 bits)
   19:
   20:				    ; Configuración para Timer 0: 20 kHz ? periodo de 50 µs
   21:				    ; Valor = 256 - (50µs / 1µs) = 256 - 50 = 206
   22:	  0033	75 8C CE	    MOV TH0, #206   ; Auto-recarga
   23:	  0036	75 8A CE	    MOV TL0, #206
   24:
   25:				    ; Configuración para Timer 1: 500 Hz ? periodo de 2 ms
   26:				    ; Valor = 65536 - 2000 = 63536 = F830h
   27:	  0039	75 8D F8	    MOV TH1, #0F8h
   28:	  003C	75 8B 30	    MOV TL1, #30h
   29:
   30:	  003F	D2 8C		    SETB TR0        ; Inicia Timer 0
   31:	  0041	D2 8E		    SETB TR1        ; Inicia Timer 1
   32:
   33:	  0043	D2 A9		    SETB ET0        ; Habilita interrupción Timer 0
   34:	  0045	D2 AB		    SETB ET1        ; Habilita interrupción Timer 1
   35:	  0047	D2 AF		    SETB EA         ; Habilita interrupciones globales
   36:
   37:	  0049			ESPERA:
   38:	  0049	80 FE		    SJMP ESPERA     ; Bucle infinito
   39:
   40:				; Rutina de interrupción para Timer 1
   41:	  004B			TIMER1ISR:
   42:	  004B	B2 B5		    CPL P3.5        ; Invierte el estado de P3.5 (tren de 500Hz)
   43:	  004D	32		    RETI

