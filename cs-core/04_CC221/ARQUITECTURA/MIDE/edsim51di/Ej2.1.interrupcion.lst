 Line  I  Addr  Code            Source

    1:				;Si quiero utilizar el interrupción generado por le timer 0 en modo 0
    2:				;debo de escribir las siquientes instrucciones:
    3:		N      0000		ORG 0000h        ; Vector de reset
    4:	  0000	02 00 30	    LJMP MAIN
    5:
    6:		N      000B	ORG 000Bh        ; Vector de interrupción Timer 0
    7:	  000B	B2 90		    CPL P1.0     ; Cambia el estado de P1.0 (tren de pulsos)
    8:	  000D	32		    RETI         ; Retorna de la interrupción
    9:
   10:		N      0030	ORG 0030h        ; Inicio del programa principal
   11:	  0030			MAIN:
   12:	  0030	75 89 02	    MOV TMOD, #02h   ; Timer 0 en modo 2 (8-bit auto-reload)
   13:	  0033	75 8C CE	    MOV TH0, #206    ; Valor inicial para 10kHz aprox
   14:	  0036	D2 8C		    SETB TR0         ; Activa Timer 0
   15:	  0038	D2 A9		    SETB ET0         ; Habilita interrupción Timer 0
   16:	  003A	D2 AF		    SETB EA          ; Habilita interrupciones globales
   17:
   18:	  003C			BUCLE:
   19:	  003C	80 FE		    SJMP BUCLE       ; Bucle infinito esperando interrupciones
   20:
   21:				END





