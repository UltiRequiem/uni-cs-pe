   87: 1  007B	CA			xch A,R2 ;pone el resultado en R2
   88: 1  007C	C4			swap A ;se convierte ahora el digito más significativo
   89: 1  007D	54 0F			anl A,#0Fh
   90: 1  007F	24 F6			add A,#0F6h ;lo ajusta
   91: 1  0081	50 02			jnc noadj2
   92: 1  0083	24 07			add A,#07h
   93: 1  0085			noadj2:
   94: 1  0085	24 3A			add A,#3Ah ;lo hace ascii
