  425: 1			; ==========================================================
  426: 1			; subrutina placeCur4
  427: 1			; Esta rutina fija la posicion del cursor. La posicion del cursor
  428: 1			; es localizado en el registro b. La posicion del cursor empieza
  429: 1			; en 0. El acumulador da el numero de linea.
  430: 1			; entrada: acumulador indica el numero de linea (1, 2)
  431: 1			; : el registro b guarda la posicion del cursor
  432: 1			; salida : nada
  433: 1			; ==========================================================
  434: 1			;
  435: 1  0205			placeCur4:
  436: 1  0205	15 E0			dec acc ; acc=0 para linea=1
  437: 1  0207	70 06			jnz line2 ; si acc=0 luego primera lnea
  438: 1  0209	E5 F0			mov a, b
  439: 1  020B	24 80			add a, #080h ; palabra de control para la linea 1
  440: 1  020D	80 04			sjmp setcur
  441: 1  020F			line2:
  442: 1  020F	E5 F0			mov a, b
  443: 1  0211	24 C0			add a, #0C0h ; palabra de control para la l¡nea 2
  444: 1  0213			setcur:
  445: 1  0213	F8			mov r0, a ; localizar palabra de control
  446: 1  0214	51 72			acall wrLCDcom4 ;
  447: 1  0216	22			ret
  448: 1			; ==========================================================
  449: 1			; subrutina setCGRAM4
  450: 1			; Esta rutina fija la direccion del Character Generator RAM. El
  451: 1			; caracter [0..7] es localizado en el acumulador. La fila del font
  452: 1			; es localizado en el registro b. Las instrucciones 40h a 7Fh
  453: 1			; selecciona las direcciones del CGRAM 0 to 3Fh (0 to 63 decimal).
  454: 1			; El font de 5x7 para el caracter es asumido. Esto es, cada posici¢n del
  455: 1			; caracter contiene una matriz de 40 puntos arreglados en 8 filas de
  456: 1			; 5 puntos cada uno. Las 7 filas son para los caracteres y la 8va
  457: 1			; fila para el cursor debajo del caracter. Direcciones de CGRAM "0" corresponde
  458: 1			; a la primera fila del caracter 0, direccion "7" corresponde
  459: 1			; al 8vo (ultima) fila del caracter 0, y direccion 3Fh
  460: 1			; corresponde a la 8va fila del caracter 7.
  461: 1			;
  462: 1			; entrada : acumulador indica el código del caracter [0..7]
  463: 1			; el registro b guarda la fila del font [0..7]
  464: 1			; salida : nada
  465: 1			; ==========================================================
  466: 1			;
  467: 1  0217			setCGRAM4:
  468: 1  0217	C0 F0				push b
  469: 1  0219	75 F0 08			mov b, #8
  470: 1  021C	A4				mul ab ; multiplica numero del caracter por 8
  471: 1  021D	D0 F0				pop b ; b sostiene numero de fila
  472: 1  021F	25 F0				add a, b ; en a se sostiene CGRAM address
  473: 1  0221	24 40				add a, #40h ; convert to instruction
  474: 1  0223	F8				mov r0, a ; place instruction
  475: 1  0224	51 72				acall wrLCDcom4 ; issue command
  476: 1  0226	22				ret
